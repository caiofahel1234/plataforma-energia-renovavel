# NUNCA versionar o .env real. Gere segredos fortes:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
POSTGRES_PASSWORD=
JWT_SECRET=
CORS_ORIGINS=https://localhost
# Admin inicial (criado no 1º boot). Depois do primeiro acesso, remova ADMIN_PASSWORD do .env.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=
# Swagger em /api/docs (desligue em produção real)
ENABLE_DOCS=true
