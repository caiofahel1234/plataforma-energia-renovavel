{
  "name": "vse-backend",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --coverage",
    "migrate": "node scripts/migrate.js",
    "create-admin": "node scripts/create-admin.js",
    "audit": "npm audit --omit=dev",
    "test:db": "node scripts/run-db-tests.js",
    "seed": "node scripts/seed.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "pg": "^8.12.0",
    "pino": "^9.3.2",
    "zod": "^3.23.8",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/config/**",
      "!src/models/**"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "lines": 80,
        "functions": 80,
        "branches": 70
      }
    }
  }
}
